RewriteEngine On

#Không cho xem cấu trúc thư mục
Options -Indexes

#Đảm bảo rằng yêu cầu không phải là một tệp hoặc thư mục
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

#Điều hướng tất cả các yêu cầu tới index.php và giữ nguyên các tham số query
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]